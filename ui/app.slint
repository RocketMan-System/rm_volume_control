import { Button, CheckBox, Switch, Slider, ComboBox, LineEdit, ScrollView, Palette, ProgressIndicator } from "std-widgets.slint";

export struct RecordData {
    id: string,
    name: string,
    process: string,
    process-title: string,
    running: bool,
    hotkey: string,
    hotkey-error: bool,
    // Adjust mode (mode 1): volume up / down / mute hotkeys and the step in percent.
    hotkey-up: string,
    hotkey-down: string,
    hotkey-mute: string,
    // All active hotkeys of the record for the header ("" = none).
    hotkey-label: string,
    // Only one of up/down is set, so neither works.
    hotkeys-incomplete: bool,
    // 0 = switch between min and max, 1 = adjust volume
    mode: int,
    step: int,
    min: int,
    max: int,
    enabled: bool,
    volume: int,
    icon: image,
    // Shown instead of a missing icon.
    initial: string,
}

export struct ProcessItem {
    label: string,
    icon: image,
    initial: string,
}

