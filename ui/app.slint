// Volume limits, set from Rust: 150 while KDE's "Raise maximum volume" is on, else 100.
export global Limits {
    in property <int> max-volume: 100;
}

// Design tokens: a dark indigo look with an orange "flame" second accent, plus a light variant.
global Theme {
    // Palette.color-scheme stays `unknown` while it follows the system, so ask the style what it resolved to.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme != ColorScheme.light && Palette.foreground == #ffffff);

    out property <color> win: dark ? #0f1116 : #f5f6fa;
    out property <color> rail: dark ? #0b0d12 : #eceef5;
    out property <color> panel: dark ? #151922 : #ffffff;
    out property <color> panel-2: dark ? #1b202b : #f1f3f8;
    out property <color> field: dark ? #0d1016 : #ffffff;
    out property <color> seg: dark ? #0d1016 : #eceef4;
    out property <color> seg-on: dark ? #1b202b : #ffffff;
    out property <color> popup: dark ? #171b25 : #ffffff;
    out property <color> line: dark ? #242a36 : #e2e5ee;
    out property <color> line-strong: dark ? #323a4a : #cfd4e0;
    out property <color> line-hover: dark ? #414a5e : #b9bfce;
    out property <color> hover: dark ? #151a24 : #e3e6ef;
    out property <color> btn-hover: dark ? #232937 : #e6e9f1;
    out property <color> ghost-hover: dark ? #1c212c : #e8ebf2;
    out property <color> track: dark ? #262c3a : #e1e4ec;
    out property <color> switch-off: dark ? #2b3140 : #cdd2dd;
    out property <color> kbd: dark ? #1e2330 : #eef0f6;
    out property <color> text: dark ? #e8eaf0 : #1b1e27;
    out property <color> muted: dark ? #8b92a3 : #5d6475;
    out property <color> faint: dark ? #5f6677 : #9aa0ae;

    out property <color> accent: #6470f0;
    out property <color> accent-hover: #7883f6;
    out property <color> accent-2: #9aa1ff;
    out property <color> accent-soft: dark ? #6470f024 : #6470f01c;
    out property <color> accent-line: #7883f68c;
    out property <color> accent-text: dark ? #b3b9ff : #4954d8;
    out property <color> flame: #ff8a3d;
    out property <color> flame-2: #ffb347;
    out property <color> flame-soft: #ff8a3d1f;
    out property <color> flame-text: dark ? #ffb347 : #d0661c;
    out property <color> ok: #3ecf7a;
    out property <color> ok-soft: #3ecf7a1f;
    out property <color> ok-text: dark ? #3ecf7a : #1f9a55;
    out property <color> warn: dark ? #f5c542 : #b98a0c;
    out property <color> warn-soft: #f5c5421c;
    out property <color> danger: #f0625a;
    out property <color> danger-soft: #f0625a1f;

    out property <color> hero: dark ? #131722 : #eef0fd;
    out property <color> hero-line: dark ? #2a3144 : #d5d9f3;
    out property <color> glass: dark ? #07090d8c : #ffffffb3;
    out property <color> glass-line: dark ? #232a3a : #dde1f3;
    out property <color> star: dark ? #ffffff : #6470f0;
}

// Clock of the ambient animations (falling stars, pulsing dots). Ticked by a ~20 fps timer in AppWindow instead of
// animation-tick(), which redraws at the display rate and costs far more CPU in the software renderer.
global Motion {
    in-out property <float> sec;
}

// Stroke icons in a 24×24 box (Lucide geometry).
global Icons {
    out property <string> bars: "M2 10v3 M6 6v11 M10 3v18 M14 8v7 M18 5v13 M22 10v3";
    out property <string> sliders: "M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6";
    out property <string> info: "M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20 M12 16v-4 M12 8h.01";
    out property <string> plus: "M12 5v14 M5 12h14";
    out property <string> pencil: "M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5L2 22l1.5-5.5Z";
    out property <string> trash: "M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2";
    out property <string> refresh: "M3 12a9 9 0 0 1 9-9a9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9a9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5";
    out property <string> swap: "M21 16l-4 4l-4-4 M17 20V4 M3 8l4-4l4 4 M7 4v16";
    out property <string> speaker: "M11 5L6 9H2v6h4l5 4V5z M15.5 8.5a5 5 0 0 1 0 7 M19 5a10 10 0 0 1 0 14";
    out property <string> mute: "M11 5L6 9H2v6h4l5 4V5z M22 9l-6 6 M16 9l6 6";
    out property <string> power: "M12 2v10 M18.4 6.6a9 9 0 1 1-12.77.04";
    out property <string> globe: "M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20 M2 12h20 M12 2a14.5 14.5 0 0 0 0 20a14.5 14.5 0 0 0 0-20";
    out property <string> moon: "M12 3a6 6 0 0 0 9 9a9 9 0 1 1-9-9Z";
    out property <string> pin: "M12 17v5 M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4a1 1 0 0 1 1 1z";
    out property <string> tray: "M22 12h-6l-2 3h-4l-2-3H2 M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z";
    out property <string> minimize: "M8 3v3a2 2 0 0 1-2 2H3 M21 8h-3a2 2 0 0 1-2-2V3 M3 16h3a2 2 0 0 1 2 2v3 M16 21v-3a2 2 0 0 1 2-2h3";
    out property <string> download: "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5l5-5 M12 15V3";
    out property <string> flask: "M10 2v7.31 M14 9.3V2 M8.5 2h7 M14 9.3a6.5 6.5 0 1 1-4 0 M5.52 16h12.96";
    out property <string> grid: "M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z";
    out property <string> code: "M16 18l6-6l-6-6 M8 6l-6 6l6 6";
    out property <string> keyboard: "M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M6 9h.01 M10 9h.01 M14 9h.01 M18 9h.01 M8 13h.01 M12 13h.01 M16 13h.01 M7 16h10";
    out property <string> x: "M18 6L6 18 M6 6l12 12";
    out property <string> check: "M20 6L9 17l-5-5";
    out property <string> chevron: "M6 9l6 6l6-6";
    out property <string> alert: "M12 2a10 10 0 1 1 0 20a10 10 0 1 1 0-20 M12 8v4 M12 16h.01";
}

component Icon inherits Path {
    in property <string> d;
    in property <color> tint: Theme.muted;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    stroke: root.tint;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    fill: transparent;
    animate stroke { duration: 150ms; }
}

// Fades and slides its content in when it is created (used by pages, editors and popups).
component Reveal inherits Rectangle {
    in property <length> shift: 6px;
    in property <duration> time: 250ms;
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: root.time; easing: ease-out; }
    opacity: self.t;
    // The layout is offset, so its size has to be passed up by hand.
    min-width: body.min-width;
    min-height: body.min-height;
    preferred-width: body.preferred-width;
    preferred-height: body.preferred-height;
    body := VerticalLayout {
        y: (1 - root.t) * root.shift;
        @children
    }
}

component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
}

// Card with radial glows and a sprinkle of stars, like the hero of the reference design.
component Hero inherits Rectangle {
    in property <color> glow-a: Theme.accent;
    in property <color> glow-b: Theme.flame;
    in property <float> stars: 0.55;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.hero-line;
    background: Theme.hero;
    clip: true;
    Rectangle {
        width: max(parent.width * 0.9, 300px);
        height: self.width;
        x: parent.width - self.width * 0.55;
        y: -self.height * 0.5;
        background: @radial-gradient(circle, root.glow-a.with-alpha(Theme.dark ? 0.30 : 0.20) 0%, root.glow-a.with-alpha(0.08) 40%, transparent 70%);
    }
    Rectangle {
        width: 340px;
        height: 340px;
        x: -self.width * 0.45;
        y: parent.height - self.height * 0.5;
        background: @radial-gradient(circle, root.glow-b.with-alpha(Theme.dark ? 0.12 : 0.10) 0%, transparent 65%);
    }
    // Slow star fall: every star drifts down and a little to the left at its own speed (bigger = closer = faster),
    // fading in at the top and out at the bottom; `y` is the starting phase.
    property <float> sec: Motion.sec;
    for s in [
        { x: 0.12, y: 0.22, r: 1.5, v: 0.050 }, { x: 0.34, y: 0.62, r: 1.0, v: 0.030 }, { x: 0.58, y: 0.28, r: 2.0, v: 0.070 },
        { x: 0.76, y: 0.84, r: 1.0, v: 0.035 }, { x: 0.88, y: 0.42, r: 1.5, v: 0.055 }, { x: 0.66, y: 0.08, r: 1.0, v: 0.028 },
        { x: 0.46, y: 0.50, r: 1.0, v: 0.040 }, { x: 0.94, y: 0.10, r: 2.0, v: 0.065 }, { x: 0.22, y: 0.70, r: 1.0, v: 0.033 },
        { x: 0.82, y: 0.36, r: 1.5, v: 0.045 }, { x: 0.05, y: 0.90, r: 1.0, v: 0.038 }, { x: 0.40, y: 0.15, r: 1.5, v: 0.060 },
    ]: Rectangle {
        property <float> p: mod(s.y + root.sec * s.v, 1);
        property <float> fade: min(1, self.p * 5, (1 - self.p) * 5);
        x: parent.width * s.x - self.p * 14px;
        y: -12px + self.p * (parent.height + 24px);
        width: s.r * 1px;
        height: s.r * 1px;
        opacity: root.stars * self.fade * (s.r > 1.5 ? 1 : 0.75);
        if s.r >= 1.5: Rectangle {
            y: -self.height;
            height: s.r * 9px;
            border-radius: self.width / 2;
            background: @linear-gradient(180deg, transparent 0%, Theme.star.with-alpha(0.45) 100%);
        }
        Rectangle {
            border-radius: self.width / 2;
            background: Theme.star;
            drop-shadow-blur: s.r > 1.5 ? 4px : 0px;
            drop-shadow-color: Theme.star.with-alpha(0.8);
        }
    }
    @children
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent-text;
    in property <color> soft: Theme.accent-soft;
    height: 20px;
    preferred-width: content.preferred-width;
    horizontal-stretch: 0;
    border-radius: 10px;
    background: self.soft;
    content := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Keyboard shortcut label.
component Kbd inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 22px;
    preferred-width: content.preferred-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: self.error ? Theme.danger-soft : Theme.kbd;
    border-width: 1px;
    border-color: self.error ? Theme.danger.with-alpha(0.45) : Theme.line-strong;
    content := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;
        VerticalLayout {
            alignment: center;
            Icon {
                d: Icons.keyboard;
                width: 13px;
                height: 13px;
                tint: root.error ? Theme.danger : Theme.muted;
            }
        }
        Text {
            text: root.text;
            color: root.error ? Theme.danger : Theme.text;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Status dot with a soft halo; `pulse` adds an expanding ring.
component Dot inherits Rectangle {
    in property <color> tint: Theme.ok;
    in property <bool> pulse;
    property <float> k: root.pulse ? min(1, mod(Motion.sec, 2) / 1.4) : 1;
    width: 8px;
    height: 8px;
    Rectangle {
        x: -3px;
        y: -3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.tint.with-alpha(0.14);
    }
    if root.pulse: Rectangle {
        width: 8px + root.k * 14px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.tint.with-alpha(0.5 * (1 - root.k));
    }
    Rectangle {
        border-radius: 4px;
        background: root.tint;
    }
}

// kind: 0 default, 1 primary, 2 ghost, 3 danger, 4 flame
component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind;
    in property <bool> enabled: true;
    in property <bool> small;
    in property <bool> active;
    callback clicked();

    property <bool> hov: ta.has-hover && root.enabled;
    property <length> icon-size: root.small ? 15px : 16px;
    property <color> fg: root.kind == 1 ? #ffffff
        : root.kind == 4 ? #1d0f04
        : root.kind == 3 ? Theme.danger
        : root.kind == 2 && !root.hov && !root.active ? Theme.muted
        : Theme.text;

    height: root.small ? 30px : 36px;
    min-width: content.min-width;
    preferred-width: content.preferred-width;
    horizontal-stretch: 0;
    border-radius: root.small ? 8px : 10px;
    border-width: 1px;
    background: root.kind == 1 ? (root.hov ? Theme.accent-hover : Theme.accent)
        : root.kind == 4 ? @linear-gradient(180deg, Theme.flame-2 0%, Theme.flame 100%)
        : root.kind == 3 ? (root.hov ? Theme.danger-soft : transparent)
        : root.kind == 2 ? (root.hov || root.active ? Theme.ghost-hover : transparent)
        : (root.hov ? Theme.btn-hover : Theme.panel-2);
    border-color: root.kind == 1 ? (root.hov ? Theme.accent-hover : Theme.accent)
        : root.kind == 3 ? Theme.danger.with-alpha(root.hov ? 0.9 : 0.35)
        : root.kind == 2 ? (root.active ? Theme.line-strong : transparent)
        : root.kind == 4 ? transparent
        : (root.hov ? Theme.line-hover : Theme.line-strong);
    drop-shadow-color: root.kind == 1 && root.enabled ? Theme.accent.with-alpha(root.hov ? 0.45 : 0.3)
        : root.kind == 4 && root.enabled ? Theme.flame.with-alpha(0.3) : transparent;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    opacity: root.enabled ? 1 : 0.4;
    animate background, border-color, drop-shadow-color { duration: 150ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    content := HorizontalLayout {
        y: ta.pressed ? 1px : 0px;
        alignment: center;
        spacing: 7px;
        padding-left: root.text == "" ? (root.height - root.icon-size) / 2 - 1px : (root.small ? 10px : 14px);
        padding-right: self.padding-left;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                tint: root.fg;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.small ? 12.5px : 13px;
            font-weight: root.kind == 1 || root.kind == 4 ? 600 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <color> on-color: Theme.accent;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? root.on-color : (ta.has-hover ? Theme.line-hover : Theme.switch-off);
    drop-shadow-blur: 14px;
    drop-shadow-color: root.checked ? root.on-color.with-alpha(0.4) : transparent;
    animate background, drop-shadow-color { duration: 200ms; }
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-action-default => { ta.clicked(); }
    Rectangle {
        x: root.checked ? 21px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000066;
        animate x { duration: 200ms; easing: ease-out; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component Check inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    spacing: 9px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            border-width: 1.5px;
            border-color: root.checked ? Theme.accent : Theme.line-hover;
            background: root.checked ? Theme.accent : Theme.field;
            animate background, border-color { duration: 120ms; }
            if root.checked: Icon {
                d: Icons.check;
                tint: #ffffff;
                width: 13px;
                height: 13px;
                stroke-width: 3px;
            }
        }
    }
    Text {
        text: root.text;
        vertical-alignment: center;
        color: Theme.text;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

// Slider with a glowing gradient fill; `mark-a` / `mark-b` draw ticks on the track (min / max of a record).
component VolSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value;
    in property <bool> enabled: true;
    in property <float> mark-a: -1;
    in property <float> mark-b: -1;
    callback changed(float);
    callback released(float);

    property <float> ratio: (root.value - root.minimum) / (root.maximum - root.minimum);
    property <length> span: root.width - 16px;
    property <bool> hot: ta.has-hover || ta.pressed || fs.has-focus;

    height: 22px;
    min-width: 80px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;

    function set-from(pos: length) {
        root.value = round(clamp((pos - 8px) / root.span, 0, 1) * (root.maximum - root.minimum) + root.minimum);
        root.changed(root.value);
    }
    function nudge(delta: float) {
        root.value = clamp(root.value + delta, root.minimum, root.maximum);
        root.changed(root.value);
        root.released(root.value);
    }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.ratio * root.span + 8px;
        height: 6px;
        border-radius: 3px;
        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-2 100%);
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.accent-hover.with-alpha(root.enabled ? 0.55 : 0);
    }
    for m in [root.mark-a, root.mark-b]: Rectangle {
        visible: m >= 0;
        x: 8px + (m - root.minimum) / (root.maximum - root.minimum) * root.span - 1px;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: 12px;
        border-radius: 1px;
        background: Theme.flame-2;
    }
    Rectangle {
        x: root.ratio * root.span + 8px - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: root.hot ? 18px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: #ffffff;
        border-width: 3px;
        border-color: Theme.accent;
        drop-shadow-blur: root.hot ? 12px : 6px;
        drop-shadow-color: Theme.accent.with-alpha(root.hot ? 0.8 : 0.45);
        animate width, drop-shadow-blur { duration: 120ms; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.nudge(-1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.nudge(1);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                fs.focus();
                root.set-from(self.mouse-x);
            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) { root.set-from(self.mouse-x); }
        }
    }
}

// Volume as a conic ring.
component Ring inherits Rectangle {
    in property <int> value;
    property <float> shown: max(0, root.value);
    property <angle> end: min(self.shown / Limits.max-volume, 1) * 360deg;
    animate shown { duration: 400ms; easing: ease-out; }
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background: root.value < 0 ? Theme.track : @conic-gradient(Theme.accent-2 0deg, Theme.accent root.end, Theme.track root.end);
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: self.width / 2;
        background: Theme.panel;
    }
    Text {
        text: root.value >= 0 ? "\{root.value}%" : "—";
        font-size: 11.5px;
        font-weight: 700;
        color: root.value >= 0 ? Theme.text : Theme.faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Segmented control with a sliding highlight.
component Seg inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected(int);
    property <length> item-w: (self.width - 6px) / max(1, root.model.length);
    height: 34px;
    min-width: root.model.length * 64px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Theme.seg;
    border-width: 1px;
    border-color: Theme.line;
    accessible-role: tab-list;
    Rectangle {
        x: 3px + root.current-index * root.item-w;
        y: 3px;
        width: root.item-w;
        height: parent.height - 6px;
        border-radius: 7px;
        background: Theme.seg-on;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.dark ? #0000004d : #1b1e2714;
        animate x { duration: 220ms; easing: ease-out; }
    }
    for item[i] in root.model: Rectangle {
        x: 3px + i * root.item-w;
        y: 3px;
        width: root.item-w;
        height: parent.height - 6px;
        accessible-role: tab;
        accessible-label: item;
        accessible-item-selected: i == root.current-index;
        accessible-action-default => { item-ta.clicked(); }
        Text {
            x: 6px;
            width: parent.width - 12px;
            text: item;
            color: i == root.current-index || item-ta.has-hover ? Theme.text : Theme.muted;
            font-weight: i == root.current-index ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: 150ms; }
        }
        item-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.current-index != i) {
                    root.current-index = i;
                    root.selected(i);
                }
            }
        }
    }
}

// Rectangle of an input: border, hover and an accent focus ring.
component FieldBox inherits Rectangle {
    in property <bool> focused;
    in property <bool> hovered;
    height: 34px;
    border-radius: 9px;
    background: Theme.field;
    border-width: 1px;
    border-color: root.focused ? Theme.accent : (root.hovered ? Theme.line-hover : Theme.line-strong);
    animate border-color { duration: 150ms; }
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        border-width: 3px;
        border-color: root.focused ? Theme.accent-soft : transparent;
        animate border-color { duration: 150ms; }
    }
}

component TextField inherits FieldBox {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    focused: ti.has-focus;
    hovered: ta.has-hover;
    horizontal-stretch: 1;
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { ti.focus(); }
    }
    if root.text == "": Text {
        x: 11px;
        width: parent.width - 22px;
        text: root.placeholder;
        color: Theme.faint;
        vertical-alignment: center;
        overflow: elide;
    }
    ti := TextInput {
        x: 11px;
        width: parent.width - 22px;
        text <=> root.text;
        single-line: true;
        vertical-alignment: center;
        color: Theme.text;
        selection-background-color: Theme.accent.with-alpha(0.45);
        selection-foreground-color: Theme.text;
        edited => { root.edited(self.text); }
    }
}

// Application icon, or its initial on a tinted square when there is none.
component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <string> initial;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: root.icon.width > 0 ? transparent : @linear-gradient(135deg, Theme.accent.with-alpha(0.55) 0%, Theme.flame.with-alpha(0.4) 100%);
    if root.icon.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.icon;
        image-fit: contain;
    }
    if root.icon.width <= 0: Text {
        text: root.initial;
        font-size: root.height * 0.55;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #ffffff;
    }
}

// Drop-down like a combo box, but its entries carry an icon.
component ProcessPicker {
    in property <[ProcessItem]> model;
    in property <int> current-index;
    callback selected(int);

    property <length> item-height: 32px;
    property <int> visible-items: min(8, root.model.length);

    min-width: 160px;
    min-height: 34px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    accessible-role: combobox;
    accessible-value: root.model[root.current-index].label;
    accessible-action-expand => { popup.show(); }

    FieldBox {
        hovered: ta.has-hover;
        focused: ta.pressed;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 10px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                AppIcon {
                    icon: root.model[root.current-index].icon;
                    initial: root.model[root.current-index].initial;
                }
            }
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.model[root.current-index].label;
                color: Theme.text;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Icon {
                    d: Icons.chevron;
                    width: 16px;
                    height: 16px;
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: root.visible-items * root.item-height + 12px;
        close-policy: close-on-click-outside;
        Reveal {
            shift: -6px;
            time: 140ms;
            Rectangle {
                border-radius: 10px;
                background: Theme.popup;
                border-width: 1px;
                border-color: Theme.line-strong;
                drop-shadow-blur: 30px;
                drop-shadow-offset-y: 12px;
                drop-shadow-color: Theme.dark ? #0000008c : #1b1e2733;
                ScrollView {
                    content-y: -max(0, root.current-index - root.visible-items + 1) * root.item-height;
                    VerticalLayout {
                        alignment: start;
                        padding: 6px;
                        for item[i] in root.model: Rectangle {
                            height: root.item-height;
                            border-radius: 7px;
                            background: i == root.current-index ? Theme.accent-soft : (item-ta.has-hover ? Theme.ghost-hover : transparent);
                            animate background { duration: 120ms; }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 9px;
                                VerticalLayout {
                                    alignment: center;
                                    AppIcon {
                                        icon: item.icon;
                                        initial: item.initial;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    text: item.label;
                                    color: i == root.current-index ? Theme.text : Theme.muted;
                                    font-weight: i == root.current-index ? 600 : 400;
                                    overflow: elide;
                                }
                                if i == root.current-index: VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        d: Icons.check;
                                        tint: Theme.accent-text;
                                        width: 15px;
                                        height: 15px;
                                    }
                                }
                            }
                            if i == root.current-index: Rectangle {
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                width: 3px;
                                height: 16px;
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }
                            item-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected(i);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    alignment: stretch;
    Text {
        text: root.label;
        width: 124px;
        vertical-alignment: center;
        color: Theme.muted;
        font-size: 12.5px;
        overflow: elide;
    }
    @children
}

// Settings row: icon tile, title with description, and a control on the right (the children).
component OptRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    in property <string> description;
    in property <string> badge;
    in property <bool> on;
    spacing: 14px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: root.on ? Theme.accent-soft : Theme.panel-2;
            animate background { duration: 200ms; }
            Icon {
                d: root.icon;
                tint: root.on ? Theme.accent-text : Theme.muted;
            }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 1px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: root.text;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.badge != "": VerticalLayout {
                alignment: center;
                Chip {
                    text: root.badge;
                    tint: Theme.flame-text;
                    soft: Theme.flame-soft;
                }
            }
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            wrap: word-wrap;
            color: Theme.muted;
        }
    }
    @children
}

component SwitchRow inherits OptRow {
    in-out property <bool> checked;
    callback toggled(bool);
    on: self.checked;
    VerticalLayout {
        alignment: center;
        Toggle {
            checked <=> root.checked;
            toggled => { root.toggled(self.checked); }
        }
    }
}

// Thin separator between settings rows.
component Sep inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

component Section inherits Card {
    in property <string> title;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        if root.title != "": Text {
            text: root.title.to-uppercase();
            color: Theme.muted;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.8px;
        }
        @children
    }
}

// Page title with an optional subtitle under it; the children (actions) sit at the right of the title.
component PageHead inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 3px;
    HorizontalLayout {
        spacing: 16px;
        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: 22px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 13px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> badge;
    in property <bool> active;
    in property <bool> compact;
    callback clicked();
    property <bool> lit: root.active || ta.has-hover;
    height: 40px;
    border-radius: 10px;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 150ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 12px;
        padding-right: root.compact ? 0px : 10px;
        spacing: 12px;
        alignment: root.compact ? center : stretch;
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                tint: root.active ? Theme.accent-text : (root.lit ? Theme.text : Theme.muted);
            }
        }
        if !root.compact: Text {
            horizontal-stretch: 1;
            text: root.text;
            vertical-alignment: center;
            color: root.lit ? Theme.text : Theme.muted;
            font-weight: root.active ? 600 : 400;
            overflow: elide;
            animate color { duration: 150ms; }
        }
        if !root.compact && root.badge != "": VerticalLayout {
            alignment: center;
            Chip {
                text: root.badge;
                tint: root.active ? Theme.accent-text : Theme.muted;
                soft: root.active ? Theme.accent-soft : Theme.kbd;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Glassy statistic tile inside the hero.
component Stat inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    in property <string> value;
    in property <string> label;
    border-radius: 12px;
    background: Theme.glass;
    border-width: 1px;
    border-color: Theme.glass-line;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 12px;
        padding-top: 10px;
        spacing: 2px;
        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: root.value;
                font-size: 22px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 10px;
                    background: root.tint.with-alpha(0.14);
                    border-width: 1px;
                    border-color: root.tint.with-alpha(0.4);
                    Icon {
                        d: root.icon;
                        tint: root.tint;
                        width: 17px;
                        height: 17px;
                    }
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.muted;
            overflow: elide;
        }
    }
}

component HotkeyRecorder inherits FieldBox {
    in property <string> value;
    out property <bool> recording: fs.has-focus;
    callback captured(string, bool, bool, bool, bool) -> bool;
    callback cleared();
    focused: root.recording;
    hovered: ta.has-hover;
    horizontal-stretch: 1;
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                self.clear-focus();
                return accept;
            }
            if (root.captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
                self.clear-focus();
            }
            accept
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 3px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;
        if root.recording: VerticalLayout {
            alignment: center;
            padding-left: 3px;
            Dot {
                tint: Theme.flame;
                pulse: true;
            }
        }
        if root.recording: Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Tr.hotkey-press;
            color: Theme.accent-text;
            overflow: elide;
        }
        if !root.recording && root.value != "": VerticalLayout {
            alignment: center;
            Kbd { text: root.value; }
        }
        if !root.recording: Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: root.value != "" ? "" : Tr.no-hotkey;
            color: Theme.faint;
            overflow: elide;
        }
        Btn {
            small: true;
            height: 26px;
            icon: Icons.keyboard;
            text: Tr.hotkey-record;
            kind: root.recording ? 1 : 0;
            clicked => { fs.focus(); }
        }
        Btn {
            small: true;
            height: 26px;
            kind: 2;
            icon: Icons.x;
            enabled: root.value != "";
            clicked => { root.cleared(); }
        }
    }
}

component Warn inherits HorizontalLayout {
    in property <string> text;
    in property <color> tint: Theme.warn;
    spacing: 7px;
    VerticalLayout {
        alignment: center;
        Icon {
            d: Icons.alert;
            tint: root.tint;
            width: 14px;
            height: 14px;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: 12px;
        color: root.tint;
        wrap: word-wrap;
    }
}

component RecordCard inherits Card {
    in property <RecordData> data;
    in property <int> index;
    in property <bool> editing;
    in property <bool> confirm-remove;
    in property <[ProcessItem]> process-items;
    in property <int> process-index;

    callback toggle-edit();
    callback ask-remove(bool);
    callback remove();
    callback set-enabled(bool);
    callback set-volume(int);
    callback toggle-now();
    callback set-name(string);
    callback set-process(int);
    callback refresh-processes();
    // The int is the hotkey slot: 0 toggle, 1 volume up, 2 volume down, 3 mute.
    callback hotkey-captured(int, string, bool, bool, bool, bool) -> bool;
    callback hotkey-cleared(int);
    callback set-min(int);
    callback set-max(int);
    callback set-mode(int);
    callback set-step(int);

    property <bool> adjust: root.data.mode == 1;
    property <bool> live: root.data.enabled && root.data.running;
    // Icon-only actions in a narrow card. Set from `changed width`: a binding would loop through the layout.
    property <bool> narrow;
    changed width => { self.narrow = self.width < 560px; }
    init => { self.narrow = self.width < 560px; }

    background: root.live ? @linear-gradient(90deg, Theme.panel.mix(Theme.accent, 0.86) 0%, Theme.panel 65%) : Theme.panel;
    border-color: root.editing ? Theme.accent-line : (ta.has-hover ? Theme.line-strong : Theme.line);
    drop-shadow-blur: root.editing ? 30px : 0px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: root.editing ? Theme.accent.with-alpha(0.12) : transparent;
    animate border-color, drop-shadow-color { duration: 200ms; }

    ta := TouchArea { }

    // Accent bar of an active record.
    Rectangle {
        x: 0;
        y: 12px;
        width: 3px;
        height: min(parent.height - 24px, 48px);
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.live ? 1 : 0;
        animate opacity { duration: 250ms; }
    }

    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line;
                    AppIcon {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        icon: root.data.icon;
                        initial: root.data.initial;
                        opacity: root.data.running ? 1 : 0.5;
                    }
                    Rectangle {
                        x: parent.width - 9px;
                        y: parent.height - 9px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: root.data.running ? Theme.ok : Theme.faint;
                        border-width: 2px;
                        border-color: Theme.panel;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "#\{root.index + 1}";
                        font-size: 12px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.data.name != "" ? root.data.name : Tr.empty-name;
                        font-size: 14.5px;
                        font-weight: 600;
                        color: root.data.enabled ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Text {
                    text: root.data.process == "" ? Tr.no-process
                        : !root.data.running ? root.data.process + " · " + Tr.process-closed
                        : root.data.volume < 0 ? root.data.process-title + " · " + Tr.process-idle
                        : root.data.process-title;
                    font-size: 12px;
                    color: root.data.running || root.data.process == "" ? Theme.muted : Theme.warn;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Ring { value: root.data.volume; }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    checked: root.data.enabled;
                    toggled => { root.set-enabled(self.checked); }
                }
            }
        }

        if root.data.hotkey-error: Warn {
            text: Tr.hotkey-busy;
            tint: Theme.danger;
        }
        if root.data.hotkeys-incomplete: Warn { text: Tr.hotkeys-incomplete; }

        VolSlider {
            maximum: Limits.max-volume;
            enabled: root.data.volume >= 0;
            value: root.data.volume < 0 ? 0 : root.data.volume;
            mark-a: root.adjust ? -1 : root.data.min;
            mark-b: root.adjust ? -1 : root.data.max;
            changed(v) => { root.set-volume(round(v)); }
        }

        if !root.confirm-remove: HorizontalLayout {
            spacing: 6px;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    if root.data.hotkey-label != "": Kbd {
                        text: root.data.hotkey-label;
                        error: root.data.hotkey-error;
                    }
                    if root.data.hotkey-label == "": Chip {
                        text: Tr.no-hotkey;
                        tint: Theme.muted;
                        soft: Theme.kbd;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Chip {
                        text: root.adjust ? "± \{root.data.step}%" : "\{root.data.min}% ⇄ \{root.data.max}%";
                        tint: Theme.flame-text;
                        soft: Theme.flame-soft;
                    }
                }
            }
            Btn {
                small: true;
                kind: 2;
                icon: root.adjust ? Icons.mute : Icons.swap;
                text: root.narrow ? "" : (root.adjust ? Tr.mute : Tr.toggle);
                accessible-label: root.adjust ? Tr.mute : Tr.toggle;
                enabled: root.data.running;
                clicked => { root.toggle-now(); }
            }
            Btn {
                small: true;
                kind: 2;
                icon: root.editing ? Icons.x : Icons.pencil;
                text: root.narrow ? "" : (root.editing ? Tr.close : Tr.edit);
                accessible-label: root.editing ? Tr.close : Tr.edit;
                active: root.editing;
                clicked => { root.toggle-edit(); }
            }
            Btn {
                small: true;
                kind: 3;
                icon: Icons.trash;
                accessible-label: Tr.remove;
                clicked => { root.ask-remove(true); }
            }
        }
        if root.confirm-remove: Reveal {
            shift: 4px;
            time: 180ms;
            Rectangle {
                border-radius: 10px;
                background: Theme.danger-soft;
                border-width: 1px;
                border-color: Theme.danger.with-alpha(0.35);
                HorizontalLayout {
                    padding: 6px;
                    padding-left: 12px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            d: Icons.trash;
                            tint: Theme.danger;
                            width: 15px;
                            height: 15px;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Tr.remove-confirm;
                        vertical-alignment: center;
                        color: Theme.danger;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Btn {
                        small: true;
                        kind: 2;
                        text: Tr.remove-no;
                        clicked => { root.ask-remove(false); }
                    }
                    Btn {
                        small: true;
                        kind: 3;
                        text: Tr.remove-yes;
                        clicked => { root.remove(); }
                    }
                }
            }
        }

        if root.editing: Reveal {
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                padding-top: 12px;
                spacing: 10px;
                FieldRow {
                    label: Tr.field-name;
                    TextField {
                        text: root.data.name;
                        placeholder: Tr.empty-name;
                        edited(t) => { root.set-name(t); }
                    }
                }
                FieldRow {
                    label: Tr.field-process;
                    ProcessPicker {
                        model: root.process-items;
                        current-index: root.process-index;
                        selected(i) => { root.set-process(i); }
                    }
                    Btn {
                        icon: Icons.refresh;
                        height: 34px;
                        accessible-label: Tr.field-refresh;
                        clicked => { root.refresh-processes(); }
                    }
                }
                FieldRow {
                    label: Tr.field-mode;
                    Seg {
                        model: [Tr.mode-toggle, Tr.mode-adjust];
                        current-index: root.data.mode;
                        selected(i) => { root.set-mode(i); }
                    }
                }
                if !root.adjust: FieldRow {
                    label: Tr.field-hotkey;
                    HotkeyRecorder {
                        value: root.data.hotkey;
                        captured(t, c, a, s, m) => { return root.hotkey-captured(0, t, c, a, s, m); }
                        cleared => { root.hotkey-cleared(0); }
                    }
                }
                if root.adjust: Text {
                    text: Tr.adjust-hint;
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                if root.adjust: FieldRow {
                    label: Tr.field-hotkey-up;
                    HotkeyRecorder {
                        value: root.data.hotkey-up;
                        captured(t, c, a, s, m) => { return root.hotkey-captured(1, t, c, a, s, m); }
                        cleared => { root.hotkey-cleared(1); }
                    }
                }
                if root.adjust: FieldRow {
                    label: Tr.field-hotkey-down;
                    HotkeyRecorder {
                        value: root.data.hotkey-down;
                        captured(t, c, a, s, m) => { return root.hotkey-captured(2, t, c, a, s, m); }
                        cleared => { root.hotkey-cleared(2); }
                    }
                }
                if root.adjust: FieldRow {
                    label: Tr.field-step;
                    VolSlider {
                        minimum: 1;
                        maximum: 50;
                        value: root.data.step;
                        released(v) => { root.set-step(round(v)); }
                    }
                    Text {
                        width: 40px;
                        text: "\{root.data.step}%";
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        color: Theme.text;
                        font-weight: 600;
                    }
                }
                if root.adjust: FieldRow {
                    label: Tr.field-hotkey-mute;
                    HotkeyRecorder {
                        value: root.data.hotkey-mute;
                        captured(t, c, a, s, m) => { return root.hotkey-captured(3, t, c, a, s, m); }
                        cleared => { root.hotkey-cleared(3); }
                    }
                }
                if !root.adjust: FieldRow {
                    label: Tr.field-min;
                    VolSlider {
                        maximum: Limits.max-volume;
                        value: root.data.min;
                        released(v) => { root.set-min(round(v)); }
                    }
                    Text {
                        width: 40px;
                        text: "\{root.data.min}%";
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        color: Theme.text;
                        font-weight: 600;
                    }
                }
                if !root.adjust: FieldRow {
                    label: Tr.field-max;
                    VolSlider {
                        maximum: Limits.max-volume;
                        value: root.data.max;
                        released(v) => { root.set-max(round(v)); }
                    }
                    Text {
                        width: 40px;
                        text: "\{root.data.max}%";
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        color: Theme.text;
                        font-weight: 600;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Apps Volume Control";
    icon: @image-url("../assets/icon256.png");
    preferred-width: 780px;
    preferred-height: 560px;
    min-width: 460px;
    min-height: 360px;
    background: Theme.win;
    default-font-size: 13px;

    in property <string> version;
    in property <[RecordData]> records;
    // Counters for the summary, kept by Rust next to `records`.
    in property <int> enabled-count;
    in property <int> running-count;
    in-out property <string> editing-id;
    in-out property <string> remove-id;
    in property <[ProcessItem]> process-items;
    in property <int> process-index;
    in property <string> status-message;
    // 0 = records, 1 = settings, 2 = about
    in-out property <int> page;

    // updater: 0 none, 1 available, 2 downloading, 3 ready, 4 error
    in property <int> update-state;
    in property <string> update-version;
    in property <float> update-progress;
    in property <string> update-check-status;

    in-out property <int> language-index;
    in property <[string]> language-names;
    in-out property <int> theme-index;
    in-out property <bool> on-top;
    in-out property <bool> close-to-tray;
    in-out property <bool> autostart;
    in-out property <bool> start-minimized;
    in-out property <bool> auto-update;
    in-out property <bool> beta-updates;
    // Linux AppImage menu entry (src/desktop.rs): 0 n/a, 1 missing, 2 ours, 3 another tool's
    in property <int> desktop-state;
    in-out property <bool> desktop-prompt;
    // Ambient animations run only while the window is on screen (set from Rust).
    in property <bool> animate: true;

    // Icons-only navigation rail on narrow windows. Updated from `changed width`: a binding would loop through the layout.
    property <bool> compact;
    changed width => { self.compact = self.width < 640px; }

    always-on-top: root.on-top;

    Timer {
        interval: 50ms;
        running: root.animate;
        triggered => { Motion.sec += 0.05; }
    }

    callback add-record();
    callback begin-edit(string);
    callback remove-record(string);
    callback set-enabled(string, bool);
    callback set-volume(string, int);
    callback toggle-now(string);
    callback set-name(string, string);
    callback set-process(string, int);
    callback refresh-processes();
    callback hotkey-captured(string, int, string, bool, bool, bool, bool) -> bool;
    callback hotkey-cleared(string, int);
    callback set-min(string, int);
    callback set-max(string, int);
    callback set-mode(string, int);
    callback set-step(string, int);

    callback download-update();
    callback install-update();
    callback open-release-page();
    callback check-updates();

    callback language-changed(int);
    callback theme-changed(int);
    callback settings-changed();
    callback open-url(string);
    callback desktop-register();
    callback desktop-unregister();
    callback desktop-prompt-answer(bool, bool);

    changed theme-index => { self.apply-theme(); }
    init => {
        self.apply-theme();
        self.compact = self.width < 640px;
    }

    function apply-theme() {
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.dark : (root.theme-index == 2 ? ColorScheme.light : ColorScheme.unknown);
    }

    HorizontalLayout {
        // Navigation rail
        Rectangle {
            // Not animated: on Windows the animation clock stops during the modal resize loop, so an animated
            // width froze at its old value while the labels already followed `compact`.
            width: root.compact ? 64px : 212px;
            background: Theme.rail;
            VerticalLayout {
                padding: 12px;
                padding-top: 16px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: root.compact ? 0px : 6px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    alignment: root.compact ? center : start;
                    Image {
                        source: @image-url("../assets/logo.svg");
                        width: 32px;
                        height: 32px;
                    }
                    if !root.compact: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Apps Volume";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "Control";
                            font-size: 11.5px;
                            color: Theme.muted;
                        }
                    }
                }
                Rectangle {
                    VerticalLayout {
                        spacing: 2px;
                        NavItem {
                            text: Tr.records;
                            icon: Icons.bars;
                            badge: root.records.length > 0 ? "\{root.records.length}" : "";
                            active: root.page == 0;
                            compact: root.compact;
                            clicked => { root.page = 0; }
                        }
                        NavItem {
                            text: Tr.settings;
                            icon: Icons.sliders;
                            active: root.page == 1;
                            compact: root.compact;
                            clicked => { root.page = 1; }
                        }
                        NavItem {
                            text: Tr.about;
                            icon: Icons.info;
                            active: root.page == 2;
                            compact: root.compact;
                            clicked => { root.page = 2; }
                        }
                    }
                    // Sliding marker of the current page on the rail edge.
                    Rectangle {
                        x: -12px;
                        y: root.page * 42px + 10px;
                        width: 3px;
                        height: 20px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: Theme.accent.with-alpha(0.7);
                        animate y { duration: 220ms; easing: ease-out; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                if !root.compact: Rectangle {
                    border-radius: 12px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    HorizontalLayout {
                        padding: 10px;
                        padding-left: 12px;
                        spacing: 11px;
                        VerticalLayout {
                            alignment: center;
                            Dot {
                                tint: root.status-message == "" ? Theme.ok : Theme.warn;
                                pulse: root.status-message == "" && root.enabled-count > 0;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "\{root.enabled-count} / \{root.records.length}  " + Tr.stat-enabled.to-lowercase();
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: root.status-message == "" ? Tr.status-ready : root.status-message;
                                font-size: 11.5px;
                                color: Theme.muted;
                                overflow: elide;
                            }
                        }
                    }
                }
                if root.compact: HorizontalLayout {
                    alignment: center;
                    padding-bottom: 8px;
                    Dot {
                        tint: root.status-message == "" ? Theme.ok : Theme.warn;
                        pulse: root.status-message == "" && root.enabled-count > 0;
                    }
                }
                Text {
                    text: "v" + root.version;
                    font-size: 11px;
                    color: Theme.faint;
                    horizontal-alignment: center;
                }
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.line;
        }

        VerticalLayout {
            horizontal-stretch: 1;

            // Update banner
            if root.update-state != 0: Reveal {
                // A plain Rectangle stretches by default and would eat the space meant for the page.
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 16px;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-bottom: 0px;
                    Rectangle {
                        border-radius: 12px;
                        clip: true;
                        background: root.update-state == 4
                            ? @linear-gradient(90deg, Theme.danger.with-alpha(0.16) 0%, Theme.panel 100%)
                            : @linear-gradient(90deg, Theme.accent.with-alpha(0.18) 0%, Theme.flame.with-alpha(0.12) 100%);
                        border-width: 1px;
                        border-color: root.update-state == 4 ? Theme.danger.with-alpha(0.45) : Theme.accent-line;
                        // Light sweeping over the banner while downloading.
                        if root.update-state == 2: Rectangle {
                            property <float> p: mod(animation-tick() / 1ms, 2400) / 2400;
                            width: parent.width * 0.4;
                            x: (self.p * 1.4 - 0.4) * parent.width;
                            background: @linear-gradient(90deg, transparent 0%, Theme.accent-2.with-alpha(0.14) 50%, transparent 100%);
                        }
                        HorizontalLayout {
                            padding: 10px;
                            padding-left: 14px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 10px;
                                    background: root.update-state == 4 ? Theme.danger-soft : Theme.accent;
                                    drop-shadow-blur: root.update-state == 4 ? 0px : 14px;
                                    drop-shadow-color: Theme.accent.with-alpha(0.45);
                                    Icon {
                                        d: root.update-state == 4 ? Icons.alert : Icons.download;
                                        tint: root.update-state == 4 ? Theme.danger : #ffffff;
                                        width: 17px;
                                        height: 17px;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 5px;
                                Text {
                                    text: root.update-state == 4 ? Tr.update-error : Tr.update-available + ": v" + root.update-version;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                if root.update-state == 2: Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.track;
                                    Rectangle {
                                        x: 0;
                                        width: max(6px, parent.width * root.update-progress);
                                        border-radius: 3px;
                                        background: @linear-gradient(90deg, Theme.accent 0%, Theme.ok 100%);
                                        drop-shadow-blur: 8px;
                                        drop-shadow-color: Theme.ok.with-alpha(0.5);
                                        animate width { duration: 200ms; }
                                    }
                                }
                            }
                            if root.update-state == 2: Text {
                                text: "\{round(root.update-progress * 100)}%";
                                vertical-alignment: center;
                                font-weight: 600;
                                color: Theme.text;
                            }
                            if root.update-state == 4 || root.update-state == 1: Btn {
                                small: true;
                                kind: 2;
                                text: Tr.update-open-page;
                                clicked => { root.open-release-page(); }
                            }
                            if root.update-state == 1: Btn {
                                small: true;
                                kind: 1;
                                icon: Icons.download;
                                text: Tr.update-download;
                                clicked => { root.download-update(); }
                            }
                            if root.update-state == 3: Btn {
                                small: true;
                                kind: 4;
                                icon: Icons.refresh;
                                text: Tr.update-install;
                                clicked => { root.install-update(); }
                            }
                        }
                    }
                }
            }

            if root.status-message != "": VerticalLayout {
                padding: 16px;
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 0px;
                Rectangle {
                    border-radius: 12px;
                    background: Theme.warn-soft;
                    border-width: 1px;
                    border-color: Theme.warn.with-alpha(0.4);
                    HorizontalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        Warn { text: root.status-message; }
                    }
                }
            }

            // Records page
            if root.page == 0: ScrollView {
                vertical-stretch: 1;
                // Explicit: the flickable's default only looks at the page's min-height.
                content-height: max(self.visible-height, records-page.preferred-height);
                records-page := Reveal {
                    VerticalLayout {
                        padding: 22px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 14px;
                        alignment: start;
                        PageHead {
                            title: Tr.records;
                            subtitle: Tr.records-desc;
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    kind: 1;
                                    icon: Icons.plus;
                                    text: root.compact ? "" : Tr.new-record;
                                    accessible-label: Tr.new-record;
                                    clicked => { root.add-record(); }
                                }
                            }
                        }
                        if root.records.length > 0: Hero {
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Stat {
                                    icon: Icons.bars;
                                    tint: Theme.accent-2;
                                    value: "\{root.records.length}";
                                    label: Tr.stat-records;
                                }
                                Stat {
                                    icon: Icons.power;
                                    tint: Theme.ok;
                                    value: "\{root.enabled-count}";
                                    label: Tr.stat-enabled;
                                }
                                if !root.compact: Stat {
                                    icon: Icons.speaker;
                                    tint: Theme.flame-2;
                                    value: "\{root.running-count}";
                                    label: Tr.stat-running;
                                }
                            }
                        }
                        if root.records.length == 0: Hero {
                            VerticalLayout {
                                padding: 28px;
                                spacing: 14px;
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 16px;
                                        background: @linear-gradient(135deg, Theme.accent-hover 0%, Theme.accent 100%);
                                        drop-shadow-blur: 24px;
                                        drop-shadow-offset-y: 8px;
                                        drop-shadow-color: Theme.accent.with-alpha(0.45);
                                        Icon {
                                            d: Icons.bars;
                                            tint: #ffffff;
                                            width: 28px;
                                            height: 28px;
                                        }
                                    }
                                }
                                Text {
                                    text: Tr.empty-data;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    color: Theme.muted;
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    Btn {
                                        kind: 1;
                                        icon: Icons.plus;
                                        text: Tr.new-record;
                                        clicked => { root.add-record(); }
                                    }
                                }
                            }
                        }
                        for rec[i] in root.records: RecordCard {
                            data: rec;
                            index: i;
                            editing: root.editing-id == rec.id;
                            confirm-remove: root.remove-id == rec.id;
                            process-items: root.process-items;
                            process-index: root.process-index;
                            toggle-edit => {
                                if (root.editing-id == rec.id) {
                                    root.editing-id = "";
                                } else {
                                    root.editing-id = rec.id;
                                    root.begin-edit(rec.id);
                                }
                            }
                            ask-remove(v) => { root.remove-id = v ? rec.id : ""; }
                            remove => {
                                root.remove-id = "";
                                if (root.editing-id == rec.id) { root.editing-id = ""; }
                                root.remove-record(rec.id);
                            }
                            set-enabled(v) => { root.set-enabled(rec.id, v); }
                            set-volume(v) => { root.set-volume(rec.id, v); }
                            toggle-now => { root.toggle-now(rec.id); }
                            set-name(v) => { root.set-name(rec.id, v); }
                            set-process(v) => { root.set-process(rec.id, v); }
                            refresh-processes => { root.refresh-processes(); root.begin-edit(rec.id); }
                            hotkey-captured(slot, t, c, a, s, m) => { return root.hotkey-captured(rec.id, slot, t, c, a, s, m); }
                            hotkey-cleared(slot) => { root.hotkey-cleared(rec.id, slot); }
                            set-min(v) => { root.set-min(rec.id, v); }
                            set-max(v) => { root.set-max(rec.id, v); }
                            set-mode(v) => { root.set-mode(rec.id, v); }
                            set-step(v) => { root.set-step(rec.id, v); }
                        }
                    }
                }
            }

            // Settings page
            if root.page == 1: ScrollView {
                vertical-stretch: 1;
                // Explicit: the flickable's default only looks at the page's min-height.
                content-height: max(self.visible-height, settings-page.preferred-height);
                settings-page := Reveal {
                    VerticalLayout {
                        padding: 22px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 14px;
                        alignment: start;
                        PageHead {
                            title: Tr.settings;
                            subtitle: Tr.settings-desc;
                        }
                        Section {
                            title: Tr.group-appearance;
                            OptRow {
                                icon: Icons.globe;
                                text: Tr.set-language;
                            }
                            Seg {
                                model: root.language-names;
                                current-index <=> root.language-index;
                                selected(i) => { root.language-changed(i); }
                            }
                            Sep { }
                            OptRow {
                                icon: Icons.moon;
                                text: Tr.set-theme;
                            }
                            Seg {
                                model: [Tr.theme-system, Tr.theme-dark, Tr.theme-light];
                                current-index <=> root.theme-index;
                                selected(i) => { root.theme-changed(i); }
                            }
                        }
                        Section {
                            title: Tr.group-behavior;
                            SwitchRow {
                                icon: Icons.pin;
                                text: Tr.set-on-top;
                                checked <=> root.on-top;
                                toggled => { root.settings-changed(); }
                            }
                            Sep { }
                            SwitchRow {
                                icon: Icons.tray;
                                text: Tr.set-close-to-tray;
                                description: Tr.set-close-to-tray-desc;
                                checked <=> root.close-to-tray;
                                toggled => { root.settings-changed(); }
                            }
                            Sep { }
                            SwitchRow {
                                icon: Icons.power;
                                text: Tr.set-autostart;
                                checked <=> root.autostart;
                                toggled => { root.settings-changed(); }
                            }
                            Sep { }
                            SwitchRow {
                                icon: Icons.minimize;
                                text: Tr.set-start-minimized;
                                checked <=> root.start-minimized;
                                toggled => { root.settings-changed(); }
                            }
                            if root.desktop-state != 0: Sep { }
                            if root.desktop-state != 0: OptRow {
                                icon: Icons.grid;
                                text: Tr.desktop-title;
                                description: root.desktop-state == 1 ? Tr.desktop-missing : (root.desktop-state == 2 ? Tr.desktop-ours : Tr.desktop-other);
                                on: root.desktop-state != 1;
                                if root.desktop-state == 1: VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        small: true;
                                        kind: 1;
                                        icon: Icons.plus;
                                        text: Tr.desktop-add;
                                        clicked => { root.desktop-register(); }
                                    }
                                }
                                if root.desktop-state == 2: VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        small: true;
                                        kind: 3;
                                        text: Tr.desktop-remove;
                                        clicked => { root.desktop-unregister(); }
                                    }
                                }
                            }
                        }
                        Section {
                            title: Tr.group-updates;
                            SwitchRow {
                                icon: Icons.download;
                                text: Tr.set-auto-update;
                                checked <=> root.auto-update;
                                toggled => { root.settings-changed(); }
                            }
                            Sep { }
                            SwitchRow {
                                icon: Icons.flask;
                                text: Tr.set-beta-updates;
                                description: Tr.set-beta-updates-desc;
                                badge: "beta";
                                checked <=> root.beta-updates;
                                toggled => { root.settings-changed(); }
                            }
                            Sep { }
                            OptRow {
                                icon: Icons.refresh;
                                text: Tr.update-check;
                                description: root.update-check-status;
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        small: true;
                                        icon: Icons.refresh;
                                        text: Tr.update-check;
                                        clicked => { root.check-updates(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // About page
            if root.page == 2: ScrollView {
                vertical-stretch: 1;
                // Explicit: the flickable's default only looks at the page's min-height.
                content-height: max(self.visible-height, about-page.preferred-height);
                about-page := Reveal {
                    VerticalLayout {
                        padding: 22px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 14px;
                        alignment: start;
                        PageHead { title: Tr.about; }
                        Hero {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 16px;
                                HorizontalLayout {
                                    spacing: 18px;
                                    Rectangle {
                                        width: 80px;
                                        height: 80px;
                                        Rectangle {
                                            x: -30px;
                                            y: -30px;
                                            width: 140px;
                                            height: 140px;
                                            background: @radial-gradient(circle, Theme.flame.with-alpha(0.22) 0%, Theme.accent.with-alpha(0.10) 45%, transparent 70%);
                                        }
                                        Image {
                                            source: @image-url("../assets/icon.svg");
                                            width: 80px;
                                            height: 80px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            alignment: start;
                                            Chip { text: "v" + root.version; }
                                        }
                                        Text {
                                            text: "Apps Volume Control";
                                            font-size: 24px;
                                            font-weight: 700;
                                            color: Theme.text;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "rocketman-streams.com";
                                            color: Theme.muted;
                                        }
                                    }
                                }
                                Text {
                                    text: Tr.about-text;
                                    wrap: word-wrap;
                                    color: Theme.dark ? #b4b9c7 : Theme.muted;
                                    font-size: 13.5px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Btn {
                                        kind: 1;
                                        icon: Icons.globe;
                                        text: Tr.about-dev;
                                        clicked => { root.open-url("https://rocketman-streams.com/"); }
                                    }
                                    Btn {
                                        icon: Icons.code;
                                        text: Tr.about-project;
                                        clicked => { root.open-url("https://github.com/RocketMan-System/rm_volume_control"); }
                                    }
                                }
                            }
                        }
                        Text {
                            text: "PolyForm Noncommercial 1.0.0  ·  UI: Slint";
                            font-size: 11.5px;
                            color: Theme.faint;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // First-start question of an AppImage, shown over the whole window.
    if root.desktop-prompt: Rectangle {
        property <float> t: 0;
        init => { self.t = 1; }
        animate t { duration: 180ms; easing: ease-out; }
        background: #04050899;
        opacity: self.t;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 40px, 440px);
            height: self.preferred-height;
            y: (parent.height - self.height) / 2 + (1 - parent.t) * 12px;
            border-radius: 16px;
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 60px;
            drop-shadow-offset-y: 24px;
            drop-shadow-color: #00000099;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 11px;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.accent-line;
                            Icon {
                                d: Icons.grid;
                                tint: Theme.accent-text;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text {
                            text: Tr.desktop-prompt-title;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: Tr.desktop-prompt-text;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }
                dont-ask := Check { text: Tr.desktop-dont-ask; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn {
                        kind: 2;
                        text: Tr.desktop-prompt-later;
                        clicked => { root.desktop-prompt-answer(false, dont-ask.checked); }
                    }
                    Btn {
                        kind: 1;
                        icon: Icons.plus;
                        text: Tr.desktop-add;
                        clicked => { root.desktop-prompt-answer(true, dont-ask.checked); }
                    }
                }
            }
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "Apps Volume Control";
    title: "Apps Volume Control";
    callback show-window();
    callback quit-app();
    clicked => { root.show-window(); }
    Menu {
        MenuItem {
            title: Tr.tray-show;
            activated => { root.show-window(); }
        }
        MenuItem {
            title: Tr.tray-quit;
            activated => { root.quit-app(); }
        }
    }
}
